generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ProjectStatus {
  CREATING
  READY
  FAILED
  GENERATING
}

enum BuildStatus {
  PENDING
  INSTALLING
  BUILDING
  SUCCESS
  FAILED
}

enum RuntimeStatus {
  STOPPED
  STARTING
  RUNNING
  CRASHED
  FAILED
}

model Project {
  id        String        @id @db.Uuid
  name      String
  folderName String       @unique
  status    ProjectStatus @default(CREATING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  buildStatus BuildStatus @default(PENDING)
  runtimeStatus RuntimeStatus @default(STOPPED)
  previewPort Int? @unique
  previewUrl String?
  buildStartedAt DateTime?
  buildCompletedAt DateTime?
  lastBuildError String?
  installStdout String?
  installStderr String?
  installExitCode Int?
  buildStdout String?
  buildStderr String?
  buildExitCode Int?
  runtimeProcessId Int?
  runtimeLogs String?
  runtimeStartedAt DateTime?
  owner     ProjectUser?
}

model ProjectUser {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model GenerationJob {
  id          String            @id @db.Uuid
  projectId   String            @db.Uuid
  userId      String            @db.Uuid
  prompt      String
  status      GenerationJobStatus @default(QUEUED)
  stdout      String?
  stderr      String?
  exitCode    Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([projectId, status])
}
