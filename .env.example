NODE_ENV=development

# PostgreSQL (use localhost from the host; the Compose service name inside Docker is postgres)
DATABASE_URL=postgresql://website_builder:website_builder@localhost:5000/website_builder

# JWT secret must be replaced with a private random value outside local development.
JWT_SECRET=replace-this-with-a-long-random-development-secret
JWT_EXPIRES_IN=1h

USER_SERVICE_PORT=3001
CORS_ORIGINS=http://localhost:5173
WORKSPACES_ROOT=./workspaces
STARTER_TEMPLATE_PATH=./templates/sample-fronted
PROJECT_MANAGER_PORT=3002
AI_GENERATION_PORT=3003
PREVIEW_BASE_URL=http://localhost
PREVIEW_PORT_START=4100
PREVIEW_PORT_END=4199

RABBITMQ_URL=amqp://website_builder:website_builder@localhost:5672
# Set true to bind each service's durable event queue to the shared topic exchange.
RABBITMQ_CONSUMER_ENABLED=true
GAPCODE_BIN=gapcode
GAPCODE_TIMEOUT_MS=600000
